var runButton = ui.Button({
  label: 'UPDATE ANALYTICS',
  style: {stretch: 'horizontal', fontWeight: 'bold'},
  onClick: function() {
    var divName = divSelect.getValue();
    var period = yearSelect.getValue().split(' ')[0]; 
    var roi = divisions[divName];
    var roiGeom = roi.geometry();
    Map.layers().reset();
    
    divLabel.setValue('DIVISION: ' + divName);
    yearLabel.setValue('YEAR: ' + period);
    fArea.setValue('Processing calculation...');

    var checkYear = period.indexOf('-') > -1 ? parseInt(period.split('-')[0]) : parseInt(period);
    var targetLulcYear = (checkYear <= 2020) ? '2018' : '2023';
    
    var lulcRaw = ee.ImageCollection('GOOGLE/DYNAMICWORLD/V1').filterBounds(roiGeom).filterDate(targetLulcYear + '-01-01', targetLulcYear + '-12-31').select('label').mode().clip(roiGeom);
    var activeLULC = reclassifyDW(lulcRaw);
    var lulcPalette = ['#00FFFF', '#228B22', '#FFFF00', '#FF69B4', '#D2B48C'];

    var permWater = getS2PermanentWater(roiGeom);
    var floodLayer;

    if (period.indexOf('-') > -1) {
        var range = period.split('-');
        var startYear = ee.Number.parse(range[0]);
        var endYear = ee.Number.parse(range[1]);
        var years = ee.List.sequence(startYear, endYear);
        var floodCol = years.map(function(y) {
          var yrStr = ee.Number(y).format('%d');
          var s1 = ee.ImageCollection('COPERNICUS/S1_GRD').filterBounds(roiGeom).filterDate(yrStr.cat('-05-20'), yrStr.cat('-09-20')).filter(ee.Filter.eq('instrumentMode', 'IW'));
          var flood = s1.median().select('VH').lt(-22).or(s1.median().select('VV').lt(-10));
          return flood.focal_median(30, 'circle', 'meters').updateMask(flood).unmask(0);
        });
        floodLayer = ee.ImageCollection(floodCol).max().updateMask(ee.ImageCollection(floodCol).max().gt(0)).updateMask(permWater.unmask().not());
    } else {
        floodLayer = getFloodInundation(period, roiGeom, permWater);
    }

    var shoreline = floodLayer.focal_max(30, 'circle', 'meters').subtract(floodLayer);
    var wseValue = dem.updateMask(shoreline).reduceRegion({
      reducer: ee.Reducer.median(), 
      geometry: roiGeom, 
      scale: 30, 
      maxPixels: 1e13
    }).getNumber('elevation');
    
    var depthImg = ee.Image.constant(wseValue).subtract(dem).updateMask(floodLayer).clamp(0, 15);

    Map.addLayer(activeLULC, {min: 1, max: 5, palette: lulcPalette}, 'LULC Baseline', false);
    Map.addLayer(permWater, {palette: '#00FFFF'}, 'Permanent Water');
    Map.addLayer(floodLayer, {palette: '#FF0000'}, 'Flood Inundation');
    Map.addLayer(ee.Image().paint(roi, 0, 2), {palette: '#000000'}, 'Boundary');

    var areaImg = ee.Image.pixelArea().divide(1e6);
    var statsDict = ee.Dictionary({
      total: roiGeom.area().divide(1e6),
      flood: areaImg.updateMask(floodLayer).reduceRegion({reducer: ee.Reducer.sum(), geometry: roiGeom, scale: 100, maxPixels: 1e13}).get('area'),
      crop: areaImg.updateMask(floodLayer).updateMask(activeLULC.eq(3)).reduceRegion({reducer: ee.Reducer.sum(), geometry: roiGeom, scale: 100, maxPixels: 1e13}).get('area'),
      built: areaImg.updateMask(floodLayer).updateMask(activeLULC.eq(4)).reduceRegion({reducer: ee.Reducer.sum(), geometry: roiGeom, scale: 100, maxPixels: 1e13}).get('area'),
      avgD: depthImg.reduceRegion({reducer: ee.Reducer.mean(), geometry: roiGeom, scale: 30, maxPixels: 1e13}).get('constant')
    });

    statsDict.evaluate(function(val) {
      if (!val) return;
      tArea.setValue('Total Area: ' + (val.total || 0).toFixed(1) + ' Km²');
      fArea.setValue('Flooded Area: ' + (val.flood || 0).toFixed(1) + ' Km²');
      fPerc.setValue('Flood Percentage: ' + ((val.flood/val.total)*100).toFixed(2) + ' %');
      cArea.setValue('Cropland Flooded: ' + (val.crop || 0).toFixed(1) + ' Km²');
      bArea.setValue('Built-Up Flooded: ' + (val.built || 0).toFixed(1) + ' Km²');
      avgDepth.setValue('Avg Flood Depth: ' + (val.avgD ? val.avgD.toFixed(2) : 0) + ' m');
    });
    Map.centerObject(roi, 7);
  }
});

